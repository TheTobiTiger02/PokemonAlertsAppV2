<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Same set as backup_rules.xml; see the reasons there. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/pokemon_alerts_preferences.preferences_pb"/>
        <include domain="sharedpref" path="widget_filter_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/pokemon_alerts_preferences.preferences_pb"/>
        <include domain="sharedpref" path="widget_filter_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
