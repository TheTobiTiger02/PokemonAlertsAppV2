<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <ImageView
        android:id="@+id/radar_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_radar_map_cd"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/radar_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_margin="8dp"
        android:background="@drawable/widget_radar_overlay_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/radar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_radar_title"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/radar_location_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#D8FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/radar_count"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_radar_count_background"
            android:gravity="center"
            android:minWidth="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/radar_toggle_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_radar_show_overview_cd"
            android:padding="12dp"
            android:src="@drawable/ic_fit_map"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/radar_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/refresh_alerts"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            android:tint="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/radar_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/widget_radar_attribution_background"
        android:paddingStart="5dp"
        android:paddingTop="2dp"
        android:paddingEnd="5dp"
        android:paddingBottom="2dp"
        android:text="@string/map_osm_attribution"
        android:textColor="#E6000000"
        android:textSize="9sp" />

    <LinearLayout
        android:id="@+id/radar_summary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:background="@drawable/widget_radar_overlay_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/radar_alert_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/widget_alert_image_cd"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/radar_alert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/radar_alert_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#D8FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/radar_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_radar_next_default_cd"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/radar_navigate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_navigate_cd"
            android:padding="12dp"
            android:src="@drawable/ic_navigate"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/radar_dismiss"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_dismiss_cd"
            android:padding="12dp"
            android:src="@drawable/ic_close_small"
            android:tint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
