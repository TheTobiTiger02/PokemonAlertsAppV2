<resources>
    <string name="settings_device_sync">Geräte-Sync</string>
    <string name="device_sync_overview_off">Aus · Einstellungen auf allen Geräten gleich halten</string>
    <string name="device_sync_intro">Hält Einstellungen, Filter, Jagden, Fangrouten, deinen Poké-Genie-Bestand und Anmeldungen auf allen Geräten gleich, die mit deinem Konto angemeldet sind. Eine Jagd oder Route, die auf einem Gerät läuft, siehst du auf den anderen und kannst sie dort steuern. Die App funktioniert auch ohne Konto.</string>
    <string name="device_sync_local_note">Fensterpositionen und der Alarmverlauf bleiben auf dem jeweiligen Gerät. Benachrichtigungs- und Anzeigeeinstellungen kannst du auf einem Gerät für sich behalten.</string>
    <string name="device_sync_sign_in">Mit Google anmelden</string>
    <string name="device_sync_sign_in_unavailable">Die Anmeldung ist in diesem Build nicht eingerichtet.</string>
    <string name="device_sync_signed_in">Angemeldet. Dieses Gerät synchronisiert jetzt.</string>
    <string name="device_sync_signed_in_as">Angemeldet als %1$s</string>
    <string name="device_sync_off_signed_in">Der Sync ist auf diesem Gerät aus.</string>
    <string name="device_sync_turn_on">Sync einschalten</string>
    <string name="device_sync_legacy_banner">Melde dich an, um weitere Geräte hinzuzufügen. Der Sync dieses Geräts wechselt dann zu deinem Konto; Kopplungscodes gibt es nicht mehr.</string>
    <string name="device_sync_paused_banner">Der Sync ist auf diesem Gerät pausiert: Er gehört zu einem Konto. Melde dich an, um ihn fortzusetzen.</string>
    <string name="device_sync_removed_notice">Dieses Gerät wurde aus deinem Konto entfernt. Es hat seine Daten behalten. Melde dich an, um es wieder zu synchronisieren.</string>
    <string name="device_sync_status">Status</string>
    <string name="device_sync_sign_out">Abmelden</string>
    <string name="device_sync_sign_out_message">Dieses Gerät synchronisiert nicht mehr und behält seine Daten. Deine anderen Geräte synchronisieren weiter.</string>
    <string name="device_sync_remove_device">Entfernen</string>
    <string name="device_sync_remove_device_title">%1$s entfernen?</string>
    <string name="device_sync_remove_device_message">Das Gerät wird abgemeldet und synchronisiert nicht mehr. Es behält seine Daten und kann sich wieder anmelden.</string>
